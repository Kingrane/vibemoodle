# Ключ Inception API для «супер кнопки» (см. src/api/inception.ts).
# Локально — скопируйте этот файл в .env и вставьте ключ.
# На хостинге задайте ту же переменную в панели окружения и пересоберите проект.
VITE_INCEPTION_API_KEY=

# «Супер кнопка 2»: пароль и ключи провайдеров для копируемого конфига
# opencode (см. src/lib/opencodeConfig.ts).
VITE_SUPER2_PASSWORD=
VITE_COARENA_API_KEY=
VITE_APINEX_API_KEY=
